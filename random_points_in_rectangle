const r = require("raylib");

function running() {
  return !r.WindowShouldClose();
}
function getRandom(x1, x2) {
  const array = [];
  for (let i = 0; i < 20; i++) {
    const distance = x2 - x1;
    const num = x1 + Math.random() * distance;
    array.push(num);
  }
  return array;
}

function setup() {
  const width = 800;
  const height = 600;

  const randomArray1 = getRandom(0, 800);
  const randomArray2 = getRandom(0, 600);

  r.SetTraceLogLevel(r.LOG_NONE);
  r.InitWindow(width, height, "randomnessTrials");
  r.SetTargetFPS(60);

  return {randomArray1, randomArray2};
}

function update() {}

function draw(array) {
  r.BeginDrawing();
  r.ClearBackground(r.BLUE);

  for (const x of array.randomArray1)
    for (const y of array.randomArray2) r.DrawCircle(x, y, 10, r.WHITE);

  r.EndDrawing();
}

function loop(array) {
  while (running()) {
    update();
    draw(array);
  }
}

function teardown() {
  r.CloseWindow();
}

function main() {
  array = setup();
  loop(array);
  teardown();
}
main();
